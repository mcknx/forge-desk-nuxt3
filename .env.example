# Copy to .env. Every variable here is optional — with none of them set the app
# runs on the in-process store and says so in a banner.

# Postgres connection string. Set it and useRepo() selects the Postgres driver;
# leave it unset and the in-process driver serves instead. POSTGRES_URL is read
# as a fallback, which is the name Vercel's integrations inject.
# DATABASE_URL=postgres://user:pass@host/db?sslmode=require

# HMAC key for the session cookie. Unset generates a random key per process:
# sessions then stop working across a restart or a second instance, which
# /api/health reports as sessionSecretConfigured:false. Set it in any deploy.
# SESSION_SECRET=

# Password for the two seeded demo accounts. Defaults to forge-desk-demo, which
# is printed on the login page — it guards nothing real.
# DEMO_PASSWORD=
