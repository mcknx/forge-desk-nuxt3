# Nuxt dev/build outputs
.output
.data
.nuxt
.nitro
.cache
dist

# Node dependencies
node_modules

# Logs
logs
*.log

# Misc
.DS_Store
.fleet
.idea

# Local env files. The negation has to come last — git takes the final matching
# pattern, so an `.env*` line after it silently re-ignored the example file and
# kept it out of the public repo.
.env
.env.*
.env*
!.env.example

# Vercel project link (contains the project/org ids, not secrets, but it is
# machine-local state rather than source)
.vercel

# Playwright output
test-results
playwright-report
